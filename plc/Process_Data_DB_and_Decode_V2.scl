// TIA Portal V19 / S7-1500
// Virtual Modbus Interface v2 replacement for the legacy 19-register decoder.
//
// Required raw buffer:
//     "Modbus_Data_DB".inputRegisters[0..6] : ARRAY OF WORD
//
// Zero-based Modbus input-register offsets:
//   0 = TEMP1 x100, 16#FFFF invalid
//   1 = TEMP2 x100, 16#FFFF invalid
//   2 = TEMP3 x100, 16#FFFF invalid
//   3 = ESP32 heartbeat
//   4 = Sensor 1 health
//   5 = Sensor 2 health
//   6 = Sensor 3 health
//
// ESP32 health enumeration:
//   0 = HEALTHY
//   1 = READ_FAILURE
//   2 = OUT_OF_RANGE
//   3 = STALE
//   4 = STUCK
//   5 = RECOVERING
//   6 = NOT_READY
//
// Architectural rule:
//   The ESP32 publishes measurement/acquisition evidence only.
//   The PLC owns communication supervision, agreement, trusted-temperature
//   selection, temperature quality, process state, trips, permissives,
//   heater demand, and simulated HEATER_OUTPUT.
//
// Migration:
//   Replace the old Process_Data_DB / Decode_Process_Data blocks with these
//   blocks in the clean virtual TIA project. Configure MB_CLIENT to read exactly
//   7 input registers into Modbus_Data_DB.inputRegisters[0..6].

DATA_BLOCK "Process_Data_DB"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
STRUCT
    Temp1_C : Real := 0.0;
    Temp2_C : Real := 0.0;
    Temp3_C : Real := 0.0;

    Temp1_Valid : Bool := FALSE;
    Temp2_Valid : Bool := FALSE;
    Temp3_Valid : Bool := FALSE;

    ESP32_Heartbeat : UInt := 0;

    Sensor1_Health : UInt := 6;
    Sensor2_Health : UInt := 6;
    Sensor3_Health : UInt := 6;
END_STRUCT;
BEGIN
END_DATA_BLOCK


FUNCTION "Decode_Process_Data" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
BEGIN
    // Decode channel-health evidence first because validity depends on it.
    "Process_Data_DB".Sensor1_Health :=
        WORD_TO_UINT("Modbus_Data_DB".inputRegisters[4]);

    "Process_Data_DB".Sensor2_Health :=
        WORD_TO_UINT("Modbus_Data_DB".inputRegisters[5]);

    "Process_Data_DB".Sensor3_Health :=
        WORD_TO_UINT("Modbus_Data_DB".inputRegisters[6]);

    "Process_Data_DB".ESP32_Heartbeat :=
        WORD_TO_UINT("Modbus_Data_DB".inputRegisters[3]);

    // A temperature is accepted as channel-valid only when the ESP32 publishes
    // a numeric value AND the corresponding acquisition health is HEALTHY.
    "Process_Data_DB".Temp1_Valid :=
        ("Modbus_Data_DB".inputRegisters[0] <> 16#FFFF)
        AND ("Process_Data_DB".Sensor1_Health = UINT#0);

    IF "Process_Data_DB".Temp1_Valid THEN
        "Process_Data_DB".Temp1_C :=
            UINT_TO_REAL(
                WORD_TO_UINT("Modbus_Data_DB".inputRegisters[0])
            ) / 100.0;
    ELSE
        "Process_Data_DB".Temp1_C := 0.0;
    END_IF;

    "Process_Data_DB".Temp2_Valid :=
        ("Modbus_Data_DB".inputRegisters[1] <> 16#FFFF)
        AND ("Process_Data_DB".Sensor2_Health = UINT#0);

    IF "Process_Data_DB".Temp2_Valid THEN
        "Process_Data_DB".Temp2_C :=
            UINT_TO_REAL(
                WORD_TO_UINT("Modbus_Data_DB".inputRegisters[1])
            ) / 100.0;
    ELSE
        "Process_Data_DB".Temp2_C := 0.0;
    END_IF;

    "Process_Data_DB".Temp3_Valid :=
        ("Modbus_Data_DB".inputRegisters[2] <> 16#FFFF)
        AND ("Process_Data_DB".Sensor3_Health = UINT#0);

    IF "Process_Data_DB".Temp3_Valid THEN
        "Process_Data_DB".Temp3_C :=
            UINT_TO_REAL(
                WORD_TO_UINT("Modbus_Data_DB".inputRegisters[2])
            ) / 100.0;
    ELSE
        "Process_Data_DB".Temp3_C := 0.0;
    END_IF;
END_FUNCTION
